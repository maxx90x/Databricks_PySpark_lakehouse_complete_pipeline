      "config": {
        "version": "1.1",
        "source": "WITH yearly_close AS (\n  SELECT \n    f.Region_Key,\n    r.Region_Name,\n    r.Stock_Exchange,\n    CAST(f.Date_Key / 10000 AS INT) AS Year,\n    AVG(f.Close) AS Avg_Year_End_Close\n  FROM db_miniproject_finance_ws.gold.fact_daily_stock_performance f\n  JOIN db_miniproject_finance_ws.gold.dim_region r ON f.Region_Key = r.Region_Key\n  WHERE r.Region_Name = 'Japan'\n  GROUP BY f.Region_Key, r.Region_Name, r.Stock_Exchange, CAST(f.Date_Key / 10000 AS INT)\n  HAVING AVG(f.Close) IS NOT NULL\n), with_roi AS (\n  SELECT \n    Region_Key, Region_Name, Stock_Exchange, Year, Avg_Year_End_Close,\n    LAG(Avg_Year_End_Close) OVER (PARTITION BY Region_Key ORDER BY Year) AS Prev_Year_Close\n  FROM yearly_close\n), roi AS (\n  SELECT\n    Region_Key, Region_Name, Stock_Exchange, Year,\n    CASE WHEN Prev_Year_Close IS NOT NULL AND Prev_Year_Close != 0 \n      THEN (Avg_Year_End_Close - Prev_Year_Close) / Prev_Year_Close * 100 \n      ELSE NULL END AS YoY_ROI_Pct\n  FROM with_roi\n), combined AS (\n  SELECT\n    roi.Region_Name,\n    roi.Stock_Exchange,\n    roi.Year,\n    roi.YoY_ROI_Pct AS Stock_ROI_Pct,\n    g.GDP_Growth_Pct\n  FROM roi\n  JOIN db_miniproject_finance_ws.gold.fact_yearly_macro_indicators g\n    ON roi.Region_Key = g.Region_Key AND roi.Year = g.Year\n  WHERE roi.YoY_ROI_Pct IS NOT NULL AND g.GDP_Growth_Pct IS NOT NULL\n) SELECT\n  Region_Name,\n  Stock_Exchange,\n  Year,\n  Stock_ROI_Pct,\n  CAST(GDP_Growth_Pct AS DECIMAL(18,2)) AS GDP_Growth_Pct\nFROM combined ORDER BY Year\n",
        "dimensions": [
          {
            "expr": "Region_Name"
          },
